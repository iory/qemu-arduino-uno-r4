 hw/intc/meson.build              |   2 +
 hw/intc/renesas_ra_icu.c         | 143 +++++++++++++++++++++++++++++++
 include/hw/intc/renesas_ra_icu.h |  39 +++++++++
 4 files changed, 187 insertions(+)
 create mode 100644 hw/intc/renesas_ra_icu.c
 create mode 100644 include/hw/intc/renesas_ra_icu.h

