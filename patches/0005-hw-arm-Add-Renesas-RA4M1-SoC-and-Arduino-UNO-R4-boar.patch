 hw/arm/arduino_uno_r4.c    |  68 +++++++++++
 hw/arm/meson.build         |   3 +
 hw/arm/ra4m1_soc.c         | 233 +++++++++++++++++++++++++++++++++++++
 include/hw/arm/ra4m1_soc.h |  62 ++++++++++
 5 files changed, 381 insertions(+)
 create mode 100644 hw/arm/arduino_uno_r4.c
 create mode 100644 hw/arm/ra4m1_soc.c
 create mode 100644 include/hw/arm/ra4m1_soc.h

