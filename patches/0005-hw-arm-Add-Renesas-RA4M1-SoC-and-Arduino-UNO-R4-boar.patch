diff --git a/hw/arm/arduino_uno_r4.c b/hw/arm/arduino_uno_r4.c
new file mode 100644
index 0000000..4c8eea2
--- /dev/null
+++ b/hw/arm/arduino_uno_r4.c
@@ -0,0 +1,68 @@
+/*
+ * Arduino UNO R4 (Renesas RA4M1)
+ *
+ * Boots a sketch built by the Arduino / PlatformIO toolchain: the ELF is
+ * linked at 0x4000, after the space the Arduino bootloader occupies.
+ * serial0 is SCI9 (Serial when the core is built with -DNO_USB),
+ * serial1 is SCI2 (Serial1, pins D0/D1).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-clock.h"
+#include "system/system.h"
+#include "hw/arm/ra4m1_soc.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+
+#define UNO_R4_ICLK_HZ   48000000ULL    /* HOCO 48 MHz */
+#define UNO_R4_PCLKB_HZ  24000000ULL    /* ICLK / 2 */
+#define UNO_R4_APP_BASE  0x4000         /* after the bootloader */
+
+static void arduino_uno_r4_init(MachineState *machine)
+{
+    DeviceState *dev;
+    RA4M1State *soc;
+    Clock *iclk, *pclkb;
+
+    iclk = clock_new(OBJECT(machine), "ICLK");
+    clock_set_hz(iclk, UNO_R4_ICLK_HZ);
+    pclkb = clock_new(OBJECT(machine), "PCLKB");
+    clock_set_hz(pclkb, UNO_R4_PCLKB_HZ);
+
+    dev = qdev_new(TYPE_RA4M1_SOC);
+    soc = RA4M1_SOC(dev);
+    object_property_add_child(OBJECT(machine), "soc", OBJECT(dev));
+    qdev_connect_clock_in(dev, "iclk", iclk);
+    qdev_connect_clock_in(dev, "pclkb", pclkb);
+    qdev_prop_set_uint32(dev, "init-svtor", UNO_R4_APP_BASE);
+    qdev_prop_set_chr(DEVICE(&soc->sci[3]), "chardev", serial_hd(0)); /* SCI9 */
+    /*
+     * On the real board Serial is USB CDC, which is not limited to 115200
+     * baud. SCI9 stands in for it, so let it send about as fast as USB.
+     */
+    object_property_set_int(OBJECT(&soc->sci[3]), "char-time-ns", 1000,
+                            &error_abort);
+    qdev_prop_set_chr(DEVICE(&soc->sci[2]), "chardev", serial_hd(1)); /* SCI2 */
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+
+    armv7m_load_kernel(soc->armv7m.cpu, machine->kernel_filename,
+                       0, RA4M1_FLASH_SIZE);
+}
+
+static void arduino_uno_r4_machine_init(MachineClass *mc)
+{
+    static const char * const valid_cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-m4"),
+        NULL
+    };
+
+    mc->desc = "Arduino UNO R4 (Renesas RA4M1, Cortex-M4)";
+    mc->init = arduino_uno_r4_init;
+    mc->valid_cpu_types = valid_cpu_types;
+}
+
+DEFINE_MACHINE_ARM("arduino-uno-r4", arduino_uno_r4_machine_init)
